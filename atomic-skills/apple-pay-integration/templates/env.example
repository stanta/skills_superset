# Illustrative configuration contract; adapt names to the actual application.
# Not deployable until merchant, policy, provider and environment gates pass.
APPLE_PAY_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_ACCOUNT_REFERENCE=
PAYMENT_MERCHANT_COUNTRY=
PAYMENT_CURRENCY=
PAYMENT_CAPTURE_MODE=
PSP_API_MODE=test
CHECKOUT_ALLOWED_ORIGINS=
APPLE_PAY_MERCHANT_ID=
# Separate Apple Wallet/session environment from PSP API mode. No auto mapping.
APPLE_PAY_SESSION_ENVIRONMENT=
APPLE_PAY_VALIDATION_OWNER=
# For SELF-MANAGED validation only: approved secret references, never key bytes.
APPLE_PAY_IDENTITY_CERT_SECRET_REF=
APPLE_PAY_IDENTITY_KEY_SECRET_REF=
APPLE_PAY_PROCESSING_KEY_OWNER=
PSP_SECRET_KEY_REF=
PSP_WEBHOOK_SECRET_REF=
# Public/publishable configuration must never contain any server secret above.
# Example identifiers in documentation: merchant.com.example.store, checkout.example.com.
