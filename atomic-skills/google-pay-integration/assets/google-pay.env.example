# Illustrative application configuration, NOT Google SDK-defined environment names.
# Adapt to the consuming framework. Default disabled + TEST. No real identifiers.
GOOGLE_PAY_ENABLED=false
GOOGLE_PAY_ENVIRONMENT=TEST
GOOGLE_PAY_MERCHANT_NAME=
GOOGLE_PAY_MERCHANT_ID=
GOOGLE_PAY_COUNTRY_CODE=
GOOGLE_PAY_CURRENCY_CODE=
GOOGLE_PAY_GATEWAY=
GOOGLE_PAY_GATEWAY_MERCHANT_ID=
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_ENVIRONMENT=test

# SERVER ONLY: load via a secret manager. Never expose as PUBLIC_/NEXT_PUBLIC_/VITE_.
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SIGNING_SECRET=
# Only for an approved DIRECT architecture; use key references, not private keys.
GOOGLE_PAY_DIRECT_KEY_REFERENCE=

# Optional merchant/PSP-owned TLM endpoint; not the PSP payment-success webhook.
GOOGLE_PAY_TOKEN_UPDATE_URL=

# Deployment validation must reject production placeholders and mismatched modes.
# Google merchantId is an identifier, not a PSP secret or gatewayMerchantId.
# Network/auth-method allowlists and amount belong in typed, validated configuration.
# Environment files are not an authorization mechanism and do not confer approval.
