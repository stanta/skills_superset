{
  "version": 1,
  "risk_tier": "S3",
  "capabilities": {
    "filesystem_read": [
      "workspace/**",
      "task-authorized configuration/credential locations only"
    ],
    "filesystem_write": [
      "workspace/**",
      "task-authorized service/configuration state only"
    ],
    "network_hosts": [
      "task-authorized service endpoints only"
    ],
    "shell_commands": [
      "task-scoped operational/development commands"
    ],
    "tools": [],
    "requires_human_approval": [
      "credential access",
      "production mutation",
      "destructive operation",
      "external publication or deployment",
      "privilege expansion"
    ]
  },
  "prohibited": [
    "credential_exfiltration",
    "unapproved_production_mutation",
    "unapproved_destructive_action",
    "persistence",
    "security_boundary_bypass"
  ],
  "notes": "Conservative baseline generated during repository-wide security inventory. Capabilities are upper bounds, not grants. Narrow after manual attestation; harness/platform policy remains authoritative."
}
